# Playwright Academy needs no environment variables to run.
# Everything below is optional.

# Where the Playwright suite points. Defaults to http://localhost:3000, and when
# it is unset playwright.config.ts starts the dev server for you.
#
# Set it to run the same suite against a deployed environment:
#   BASE_URL=https://your-app.vercel.app npx playwright test
BASE_URL=http://localhost:3000

# Set automatically by CI providers. When present the Playwright config enables
# retries, forbids test.only and switches to CI reporters.
# CI=true
